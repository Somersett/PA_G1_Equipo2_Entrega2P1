"""Fecha y hora en formato ISO 8601."""
scalar DateTime

"""Fecha calendario en formato ISO 8601."""
scalar Date

schema {
  query: Query
}

type Query {
  """Obtiene la vista consolidada de un miembro por identificador."""
  member(id: Int!): MemberOverview
}

type MemberOverview {
  member: Member!
  membership: Membership
  recentAccesses(limit: Int = 10): [AccessAttempt!]!
}

type Member {
  id: Int!
  document: String!
  name: String!
  phone: String!
  email: String
  createdAt: DateTime!
}

type Membership {
  id: Int!
  memberId: Int!
  planId: Int!
  status: MembershipStatus!
  startDate: Date
  endDate: Date
  createdAt: DateTime!
}

type AccessAttempt {
  attemptId: Int!
  memberId: Int!
  result: AccessResult!
  reason: String!
  occurredAt: DateTime!
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum AccessResult {
  ACCESS_GRANTED
  ACCESS_DENIED
}
