# Copie este archivo como infrastructure/.env (no versionado) y cambie las claves.
# Valores solo para el entorno académico local.

# queries_db: mismas credenciales locales que define el servicio postgres de docker-compose.yml.
QUERIES_DB_USERNAME=gym_user
QUERIES_DB_PASSWORD=gym_password

# Credencial interna Gateway -> Consolidated Queries Service (mínimo 12 caracteres).
QUERIES_API_USERNAME=graphql-gateway
QUERIES_API_PASSWORD=cambie-esta-clave-interna

# Credencial HTTP Basic de los clientes GraphQL (mínimo 12 caracteres).
# Es también el usuario y la contraseña para ingresar al panel administrativo (http://localhost:3000).
GATEWAY_CLIENT_USERNAME=admin
GATEWAY_CLIENT_PASSWORD=cambie-esta-clave-admin

# Orígenes del navegador autorizados para CORS, separados por comas. Vacío: ninguno.
GATEWAY_CORS_ALLOWED_ORIGINS=

# Perfil Spring del gateway. "local" habilita GraphiQL en http://localhost:8080/graphiql (solo desarrollo
# local; sigue exigiendo HTTP Basic). Use "default" o deje vacío en cualquier otro entorno.
GATEWAY_SPRING_PROFILES_ACTIVE=default

# Simulador de Members, Memberships, Payments y Access Control: usa members_db, memberships_db,
# payments_db y access_db con las credenciales locales de PostgreSQL.
SIMULATOR_DB_USERNAME=gym_user
SIMULATOR_DB_PASSWORD=gym_password

# Zona horaria para calcular vigencias y vencimientos de membresías.
BUSINESS_TIMEZONE=America/Bogota

# Puertos publicados en este equipo. Si alguno ya está ocupado (por ejemplo, un PostgreSQL instalado),
# cámbielo aquí. Los scripts iniciar.* lo detectan y lo ajustan automáticamente.
# Los clientes solo entran por el panel (ADMIN_WEB_PORT) o el gateway (GATEWAY_HOST_PORT). PostgreSQL y
# Kafka se publican solo en 127.0.0.1. Consolidated Queries y el simulador no publican puerto.
ADMIN_WEB_PORT=3000
GATEWAY_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
